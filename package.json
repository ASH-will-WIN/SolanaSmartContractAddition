{
  "name": "conditional-escrow-mvp",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:backend": "tsx --test tests/backend-flow.test.ts",
    "anchor:test": "anchor test",
    "spacetime:start": "spacetime start --listen-addr 127.0.0.1:3001 --data-dir ./.spacetime-data",
    "spacetime:build": "spacetime build --module-path spacetime/spacetimedb",
    "spacetime:generate": "spacetime generate --lang typescript --module-path spacetime/spacetimedb --out-dir lib/spacetime/module_bindings",
    "spacetime:publish": "spacetime publish condition-oracle --module-path spacetime/spacetimedb --server http://127.0.0.1:3001 --yes"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "@xyflow/react": "^12.12.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "spacetimedb": "^2.10.2"
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "11.1.0"
    }
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.19",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "chai": "^4.5.0",
    "mocha": "^10.7.3",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
